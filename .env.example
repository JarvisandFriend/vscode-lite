# Base URL of the VS Code Lite backend (the Express/node-pty server that
# serves /api/* and the /ws/terminal WebSocket). The packaged mobile app has
# no local server to call relative paths against, so every request is
# rewritten at runtime to point here (see src/legacy/appLogic.js and
# src/legacy/terminalManager.js).

# REST API base, no trailing slash:
VITE_API_URL=https://your-backend-host.example.com

# WebSocket base, no trailing slash, ws:// or wss://:
VITE_WS_URL=wss://your-backend-host.example.com
